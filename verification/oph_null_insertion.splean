-- NEXT LEVEL: how to INSERT a null-space inside a committed world, so it can be filled.
--
-- The complementarity (oph_null_space_creation.splean) said: committed sectors are
-- FORCED (unique value), so a fully-written world has no free null. To get a fillable
-- null INSIDE the world you must locally SEVER the committed content. Physically this
-- is boundary-making: a horizon, decoherence-isolation, cosmic expansion, or a
-- topological defect — each produces a region that borders the world yet carries no
-- committed readback.
--
-- Model that severing as `open2 : S -> S` with open_law : r(open2 s) = none, and
-- filling as `put : V -> S -> S` with fill_law : r(put v s) = some v.
--
-- Machine-checked:
--   opened_is_null     : opening yields a genuine null (insertion works)
--   opened_is_fillable : the opened null accepts ANY value (it is fillable, freely)
--   open_erases        : opening a COMMITTED sector cannot leave it unchanged
--                        -> inserting a fillable null COSTS erasure of what was there
--                        (the OPH echo of Landauer / holographic-capacity bookkeeping).
-- So new fillable null-space comes from exactly two routes: fresh capacity (a NEW
-- null sector, no erasure — expansion/horizon growth) or reopening (erase to free).
-- Run: spleanql oph_null_insertion.splean

inductive Eq.{u} (a : Sort u) (x : a) : a -> Prop where
  | Eq.refl : Eq.{u} a x x
inductive True : Prop where
  | triv : True
inductive False : Prop where

def eqtrans : (A : Type) -> (x : A) -> (y : A) -> (z : A) -> Eq.{1} A x y -> Eq.{1} A y z -> Eq.{1} A x z :=
  fun (A : Type) (x : A) (y : A) (z : A) (h1 : Eq.{1} A x y) (h2 : Eq.{1} A y z) =>
    Eq.rec.{1,0} A y (fun (z : A) (t : Eq.{1} A y z) => Eq.{1} A x z) h1 z h2
def eqsym : (A : Type) -> (x : A) -> (y : A) -> Eq.{1} A x y -> Eq.{1} A y x :=
  fun (A : Type) (x : A) (y : A) (h : Eq.{1} A x y) =>
    Eq.rec.{1,0} A x (fun (y : A) (t : Eq.{1} A x y) => Eq.{1} A y x) (Eq.refl.{1} A x) y h

axiom V : Type
inductive Opt : Type where
  | none : Opt
  | some : V -> Opt
def IsNull : Opt -> Prop :=
  fun (o : Opt) => Opt.rec.{1} (fun (x : Opt) => Prop) True (fun (v : V) => False) o
theorem some_ne_none : (v : V) -> Eq.{1} Opt (some v) none -> False :=
  fun (v : V) (h : Eq.{1} Opt (some v) none) =>
    Eq.rec.{1,0} Opt none (fun (o : Opt) (t : Eq.{1} Opt none o) => IsNull o)
      triv (some v) (eqsym Opt (some v) none h)

axiom S : Type
axiom r : S -> Opt
axiom put : V -> S -> S        -- fill a sector with a value
axiom open2 : S -> S           -- insert a null: sever the sector's committed content
axiom fill_law : (v : V) -> (s : S) -> Eq.{1} Opt (r (put v s)) (some v)
axiom open_law : (s : S) -> Eq.{1} Opt (r (open2 s)) none

-- (1) insertion works: the opened sector is a genuine null.
theorem opened_is_null : (s : S) -> (v : V) -> Eq.{1} Opt (r (open2 s)) (some v) -> False :=
  fun (s : S) (v : V) (h : Eq.{1} Opt (r (open2 s)) (some v)) =>
    some_ne_none v (eqtrans Opt (some v) (r (open2 s)) none (eqsym Opt (r (open2 s)) (some v) h) (open_law s))

-- (2) fillable: the opened null accepts ANY value.
theorem opened_is_fillable : (s : S) -> (v : V) -> Eq.{1} Opt (r (put v (open2 s))) (some v) :=
  fun (s : S) (v : V) => fill_law v (open2 s)

-- (3) no free lunch: opening a COMMITTED sector cannot leave it unchanged (insertion erases).
theorem open_erases :
  (s : S) -> (u : V) -> Eq.{1} Opt (r s) (some u) -> Eq.{1} Opt (r s) (r (open2 s)) -> False :=
  fun (s : S) (u : V) (hcommit : Eq.{1} Opt (r s) (some u)) (hsame : Eq.{1} Opt (r s) (r (open2 s))) =>
    some_ne_none u (eqtrans Opt (some u) (r (open2 s)) none
      (eqtrans Opt (some u) (r s) (r (open2 s)) (eqsym Opt (r s) (some u) hcommit) hsame)
      (open_law s))

#axioms opened_is_null
#axioms opened_is_fillable
#axioms open_erases
